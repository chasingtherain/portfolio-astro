---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import GitHubActivity from "../components/GitHubActivity.tsx";

const personalInfo = {
  name: "Jay Thia",
  tagline: "Building with AI to solve real-world problems",
  email: "chasingtherain22@gmail.com",
  github: "https://github.com/chasingtherain",
  linkedin: "https://www.linkedin.com/in/jaythia/",
};

const projects = [
  {
  title: "Agentic Bitcoin Newsletter",
  description: "AI Agent Pipeline: Automated Bitcoin newsletter using multi-agent architecture with A2A protocol for coordinated data collection, content generation, and publishing",
  stack: ["AI-assisted","Python", "Claude API", "A2A", "CoinGecko", "RSS Feeds"],
  repo: "",
  liveSite: null
  },
  {
    title: "ChoreOS",
    description: "A Telegram bot that turns household chores into a trackable maintenance system, with smart scheduling, live status reports, and one-tap updates — powered by Google Apps Script and Sheets.",
    stack: ["AI-assisted","Google Apps Script", "Telegram Bot API", "Google Sheets", "Pipedream"],
    repo: "https://github.com/chasingtherain/choreos-bot",
    liveSite: null
  },
  {
    title: "Better Daily",
    description: "A journaling app that helps users build reflection habits through daily prompts and progress tracking.",
    stack: ["Pre-AI","Next.js", "TypeScript", "Postgres", "Tailwind CSS", "Radix UI"],

    repo: "https://github.com/chasingtherain/better-daily",
    deck: "https://docs.google.com/presentation/d/14fDolZ_Qmv5V4GRzopHqVTuC3M1RH2Ia_TItmcdHuRo/edit?usp=sharing",
    liveSite: "https://www.betterdailyjournal.com/"
  },
  {
    title: "Track Travel",
    description: "Track and visualize your travels across UNESCO World Heritage Sites and theme parks worldwide.",
    stack: ["Pre-AI","React", "React Query", "Firebase", "Tailwind CSS", "Jest"],
    repo: "https://github.com/chasingtherain/unesgo-explore",
    deck: "https://docs.google.com/presentation/d/1q8QFDQM9px4jS1U1ZgrUpdLv48FMazI3tiqm2d46P_E/edit?usp=sharing",
    liveSite: "https://tracktravel.co/"
  },
  {
    title: "Leave Plans",
    description: "Team leave management system with calendar views, approval workflows, and team availability tracking.",
    stack: ["Pre-AI","React", "Node.js", "Express", "MongoDB", "Tailwind CSS"],
    repo: "https://github.com/chasingtherain/leave-management/",
    deck: "https://docs.google.com/presentation/d/1zI_5tlsEWro4H2Z4jx-zqPo4QSiwqYXOSZxQ7XXVQWg/edit?usp=sharing",
    liveSite: null
  },
  {
    title: "Remind Me",
    description: "Schedule email reminders for yourself or others—never forget birthdays, deadlines, or important dates.",
    stack: ["Pre-AI","Next.js", "Postgres", "Material UI"],
    repo: "https://github.com/chasingtherain/remindme-next",
    liveSite: "https://sendmeareminder.vercel.app/"
  }
];
---

<Layout title={`${personalInfo.name} | Portfolio`}>
  <!-- Header / Navigation -->
  <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-sm dark:border-gray-700 dark:bg-gray-900/80">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
      <a href="/" class="text-lg font-bold">{personalInfo.name}</a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-6 md:flex">
        <ul class="flex gap-6 text-sm">
          <li><a href="#about" class="nav-link hover:text-gray-600 dark:hover:text-gray-300">About</a></li>
          <li><a href="#projects" class="nav-link hover:text-gray-600 dark:hover:text-gray-300">Projects</a></li>
          <li><a href="/Jay_Thia_Resume.pdf" download class="hover:text-gray-600 dark:hover:text-gray-300">Resume</a></li>
        </ul>
        <ThemeToggle />
      </div>

      <!-- Mobile Navigation Controls -->
      <div class="flex items-center gap-4 md:hidden">
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          type="button"
          class="p-2 hover:bg-gray-100 rounded-lg dark:hover:bg-gray-800"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <!-- Hamburger icon -->
          <svg id="hamburger-icon" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg id="close-icon" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu (hidden by default) -->
    <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white px-4 py-4 md:hidden dark:border-gray-700 dark:bg-gray-900">
      <ul class="flex flex-col gap-4 text-sm">
        <li><a href="#about" class="nav-link block py-2 hover:text-gray-600 dark:hover:text-gray-300">About</a></li>
        <li><a href="#projects" class="nav-link block py-2 hover:text-gray-600 dark:hover:text-gray-300">Projects</a></li>
        <li><a href="/Jay_Thia_Resume.pdf" download class="block py-2 hover:text-gray-600 dark:hover:text-gray-300">Resume</a></li>
      </ul>
    </div>
  </header>

  <main class="relative z-10">
    <!-- Aurora glow effects - contained to prevent mobile overflow -->
    <div class="aurora-container">
      <div class="aurora-glow-primary"></div>
      <div class="aurora-glow-secondary"></div>
    </div>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="mx-auto max-w-5xl px-4 py-20 md:py-32">
        <h1 class="text-4xl font-bold md:text-6xl">{personalInfo.name}</h1>
        <p class="mt-4 text-xl text-gray-600 md:text-2xl dark:text-gray-400">{personalInfo.tagline}</p>
        <div class="mt-8 flex gap-4">
          <a
            href="#projects"
            class="rounded-lg bg-gray-900 px-6 py-3 text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200"
          >
            View Projects
          </a>
          <a
            href="#contact"
            class="rounded-lg border border-gray-300 px-6 py-3 hover:bg-gray-50 dark:border-gray-600 dark:hover:bg-gray-800"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="border-t border-gray-200 dark:border-gray-700">
      <div class="mx-auto max-w-5xl px-4 py-20">
        <h2 class="text-3xl font-bold">About Me</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-2">
          <div>
            <p class="text-gray-600 dark:text-gray-400">
              Product background. Engineering skills. Currently helping clients turn data into revenue at Plusgrade.
            </p>
            <p class="mt-4 text-gray-600 dark:text-gray-400">
              Built these projects during a sabbatical to learn the craft. Now I build AI-powered tooling to automate analytics workflows in my day job.
            </p>
          </div>
          <div class="min-w-0">
            <GitHubActivity client:load />
          </div>
        </div>

        <div class="mt-8">
          <h3 class="font-semibold">Skills</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Claude</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">JavaScript</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">TypeScript</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Python</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">React</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Next.js</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Node.js</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">PostgreSQL</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">MongoDB</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Firebase</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Tailwind CSS</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">SQL</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Splunk</li>
            <li class="rounded bg-gray-100 px-3 py-1 dark:bg-gray-800">Figma</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-transparent">
      <div class="mx-auto max-w-5xl px-4 py-20">
        <h2 class="text-3xl font-bold">Projects</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">A selection of my recent work</p>

        <div class="mt-12 grid gap-8 md:grid-cols-2">
          {projects.map((project) => (
            <article class="flex flex-col rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900/80">
              <h3 class="text-xl font-semibold">{project.title}</h3>
              <p class="mt-2 flex-1 text-gray-600 dark:text-gray-400">{project.description}</p>

              <div class="mt-4 flex flex-wrap gap-2">
                {project.stack.map((tech) => (
                  <span class="rounded bg-gray-100 px-2 py-1 text-xs dark:bg-gray-800">{tech}</span>
                ))}
              </div>

              <div class="mt-4 flex flex-wrap gap-3 text-sm">
                {project.liveSite && (
                  <a
                    href={project.liveSite}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600 dark:hover:text-gray-300"
                  >
                    Live Site
                  </a>
                )}
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600 dark:hover:text-gray-300"
                  >
                    GitHub
                  </a>
                )}
                {project.deck && (
                  <a
                    href={project.deck}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600 dark:hover:text-gray-300"
                  >
                    Deck
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-transparent">
      <div class="mx-auto max-w-5xl px-4 py-20">
        <h2 class="text-3xl font-bold">Get in Touch</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Interested in working together? Let's talk.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={`mailto:${personalInfo.email}`}
            class="rounded-lg bg-gray-900 px-6 py-3 text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200"
          >
            Contact Me
          </a>
          <a
            href={personalInfo.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-gray-300 p-3 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-800"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href={personalInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-gray-300 p-3 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-800"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor">
              <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-200 dark:border-gray-700">
    <div class="mx-auto max-w-5xl px-4 py-8">
      <p class="text-center text-sm text-gray-500 dark:text-gray-400">
        &copy; {new Date().getFullYear()} {personalInfo.name}. All rights reserved.
      </p>
    </div>
  </footer>
</Layout>

<script is:inline>
  (function() {
    // Mobile menu toggle
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', function() {
        const isOpen = !mobileMenu.classList.contains('hidden');

        if (isOpen) {
          mobileMenu.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          menuButton.setAttribute('aria-expanded', 'false');
        } else {
          mobileMenu.classList.remove('hidden');
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          menuButton.setAttribute('aria-expanded', 'true');
        }
      });

      // Close mobile menu when clicking a nav link
      const mobileNavLinks = mobileMenu.querySelectorAll('.nav-link');
      mobileNavLinks.forEach(function(link) {
        link.addEventListener('click', function() {
          mobileMenu.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          menuButton.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
      anchor.addEventListener('click', function(event) {
        const targetId = this.getAttribute('href');
        if (targetId === '#') return;

        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          event.preventDefault();
          const headerHeight = document.querySelector('header').offsetHeight;
          const targetPosition = targetElement.getBoundingClientRect().top + window.scrollY - headerHeight;

          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  })();
</script>

<style>
  /* Aurora container - prevents glow from causing mobile overflow */
  .aurora-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* Aurora glow effect - organic shapes, stays at top of page */
  .aurora-glow-primary,
  .aurora-glow-secondary {
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }

  /* Primary glow - elongated teal sweep from top-left */
  .aurora-glow-primary {
    top: -150px;
    left: -200px;
    width: 1200px;
    height: 500px;
    background: linear-gradient(
      135deg,
      rgba(16, 185, 129, 0.4) 0%,
      rgba(16, 185, 129, 0.2) 30%,
      rgba(16, 185, 129, 0.05) 60%,
      transparent 100%
    );
    filter: blur(80px);
    transform: rotate(-15deg);
  }

  /* Secondary glow - soft blue accent */
  .aurora-glow-secondary {
    top: 100px;
    left: 150px;
    width: 900px;
    height: 400px;
    background: linear-gradient(
      120deg,
      rgba(59, 130, 246, 0.35) 0%,
      rgba(6, 182, 212, 0.15) 50%,
      transparent 100%
    );
    filter: blur(100px);
    transform: rotate(-10deg);
  }

  /* Show aurora in dark mode */
  :global(.dark) .aurora-glow-primary {
    opacity: 1;
  }

  :global(.dark) .aurora-glow-secondary {
    opacity: 0.8;
  }
</style>
